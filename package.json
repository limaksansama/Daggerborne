{
  "name": "daggerborne-android",
  "version": "0.6.2-beta",
  "private": true,
  "description": "Android packaging for the Daggerborne PWA",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "lint": "node --check server.js && node scripts/lint.mjs",
    "verify": "npm run lint && npm test",
    "build": "npm run verify && node -e \"console.log('Static site ready')\"",
    "build:android": "npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/core": "6.2.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1"
  }
}
